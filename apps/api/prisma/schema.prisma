generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// What someone who is not the owner may do with a production. A producer and a
/// production accountant both need to work on the same show; a financier or a
/// department head may only need to read it.
enum ProductionRole {
  editor
  viewer
}

enum ImportSourceType {
  // The primary input. Everything else is either a document from a production
  // already under way, or a past show to learn spread shapes from.
  budget_pdf
  cashflow_xlsx
  hotcost_xls
}

enum ImportStatus {
  queued
  processing
  completed
  failed
  needs_review
}

enum PeriodType {
  ctd
  commitment
  preprep
  prep
  shoot
  hiatus
  post
}

enum CashFlowLineType {
  detail
  fringe
  subtotal
  header
  grand_total
  cumulative_total
}

enum SnapshotType {
  imported
  recalculated
  scenario
}

/// A person with a login. Productions belong to exactly one of these, and the
/// API never returns a production to anyone else — invitation grants access to
/// the application, not to another user's shows.
model User {
  id           String             @id @default(uuid()) @db.Uuid
  email        String             @unique
  name         String?
  passwordHash String             @map("password_hash")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt  DateTime?          @map("last_login_at") @db.Timestamptz(6)
  productions  Production[]
  sessions     Session[]
  invitesSent  Invite[]           @relation("InvitedBy")
  memberships  ProductionMember[]
  membersAdded ProductionMember[] @relation("MemberAddedBy")

  @@map("users")
}

/// Opaque server-side sessions rather than a signed token, so that signing out
/// and revoking access actually take effect. The cookie carries the token; only
/// its hash is stored, so a leaked database row cannot be replayed as a login.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A one-time invitation to create an account. Stored as a hash for the same
/// reason as a session: the link is a credential until it is used.
model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  // An invitation can carry a share, so "put my accountant on this show" is one
  // action rather than an invite now and a second visit once they have signed up.
  productionId String?         @map("production_id") @db.Uuid
  role         ProductionRole?
  production   Production?     @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invites")
}

model Production {
  id               String             @id @default(uuid()) @db.Uuid
  // Nullable only so the column can be added to a database that already holds
  // rows. The API treats an unowned production as invisible rather than as
  // public — see scripts/claim-orphan-productions.js to adopt them.
  ownerId          String?            @map("owner_id") @db.Uuid
  owner            User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Archiving hides a show from the picker without destroying it. A slate
  // accumulates finished pictures, and "delete" is the wrong answer for a film
  // that wrapped — the cash flow is the record of what it cost.
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(6)
  title            String
  currency         String
  region           String?
  status           String
  startDate        DateTime?          @db.Date
  endDate          DateTime?          @db.Date
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  importBatches    ImportBatch[]
  periods          CashFlowPeriod[]
  sections         CashFlowSection[]
  lineItems        CashFlowLineItem[]
  snapshots        ForecastSnapshot[]
  hotCostDays      HotCostDay[]
  hotCostLineItems HotCostLineItem[]
  members          ProductionMember[]
  pendingInvites   Invite[]

  @@index([ownerId])
  @@index([archivedAt])
  @@map("productions")
}

/// Somebody other than the owner who can see this production. The owner is not a
/// row here — ownership lives on the production itself, so there is exactly one
/// and it cannot be revoked by accident.
model ProductionMember {
  id           String         @id @default(uuid()) @db.Uuid
  productionId String         @map("production_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  role         ProductionRole @default(viewer)
  addedById    String?        @map("added_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  production   Production     @relation(fields: [productionId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy      User?          @relation("MemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([productionId, userId])
  @@index([userId])
  @@map("production_members")
}

model ImportBatch {
  id               String             @id @default(uuid()) @db.Uuid
  productionId     String             @map("production_id") @db.Uuid
  sourceType       ImportSourceType   @map("source_type")
  originalFilename String             @map("original_filename")
  fileStorageKey   String             @map("file_storage_key")
  importStatus     ImportStatus       @map("import_status")
  parserVersion    String             @map("parser_version")
  startedAt        DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(6)
  errorSummary     String?            @map("error_summary")
  metadataJson     Json?              @map("metadata_json")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  production       Production         @relation(fields: [productionId], references: [id], onDelete: Cascade)
  lineItems        CashFlowLineItem[]
  hotCostDays      HotCostDay[]

  @@map("import_batches")
}

model CashFlowPeriod {
  id              String               @id @default(uuid()) @db.Uuid
  productionId    String               @map("production_id") @db.Uuid
  sequence        Int
  label           String
  periodType      PeriodType           @map("period_type")
  // Populated from the date row above the period labels. Present in the schema
  // from the start; never filled until the parser stopped keying off labels.
  weekEndingDate  DateTime?            @map("week_ending_date") @db.Date
  sourceColumnKey String               @map("source_column_key")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  production      Production           @relation(fields: [productionId], references: [id], onDelete: Cascade)
  allocations     CashFlowAllocation[]

  @@unique([productionId, sequence])
  @@map("cash_flow_periods")
}

model CashFlowSection {
  id                   String             @id @default(uuid()) @db.Uuid
  productionId         String             @map("production_id") @db.Uuid
  code                 String?
  name                 String
  displayOrder         Int                @map("display_order")
  includedInGrandTotal Boolean            @default(true) @map("included_in_grand_total")
  sourceStartRow       Int?               @map("source_start_row")
  sourceEndRow         Int?               @map("source_end_row")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  production           Production         @relation(fields: [productionId], references: [id], onDelete: Cascade)
  lineItems            CashFlowLineItem[]

  @@unique([productionId, displayOrder])
  @@map("cash_flow_sections")
}

model CashFlowLineItem {
  id                String               @id @default(uuid()) @db.Uuid
  productionId      String               @map("production_id") @db.Uuid
  sectionId         String?              @map("section_id") @db.Uuid
  importBatchId     String?              @map("import_batch_id") @db.Uuid
  accountCode       String?              @map("account_code")
  description       String
  lineType          CashFlowLineType     @map("line_type")
  sourceRowNumber   Int?                 @map("source_row_number")
  ctdAmount         Decimal?             @map("ctd_amount") @db.Decimal(14, 2)
  commitmentsAmount Decimal?             @map("commitments_amount") @db.Decimal(14, 2)
  importedTotal     Decimal?             @map("imported_total") @db.Decimal(14, 2)
  formulaJson       Json?                @map("formula_json")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  production        Production           @relation(fields: [productionId], references: [id], onDelete: Cascade)
  section           CashFlowSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  importBatch       ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  allocations       CashFlowAllocation[]

  @@index([productionId])
  @@index([sectionId])
  @@index([accountCode])
  @@map("cash_flow_line_items")
}

model CashFlowAllocation {
  id               String           @id @default(uuid()) @db.Uuid
  lineItemId       String           @map("line_item_id") @db.Uuid
  periodId         String           @map("period_id") @db.Uuid
  amount           Decimal          @db.Decimal(14, 2)
  importedValue    Decimal?         @map("imported_value") @db.Decimal(14, 2)
  sourceFormula    String?          @map("source_formula")
  isManualOverride Boolean          @default(false) @map("is_manual_override")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  lineItem         CashFlowLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  period           CashFlowPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([lineItemId, periodId])
  @@map("cash_flow_allocations")
}

model ForecastSnapshot {
  id                   String       @id @default(uuid()) @db.Uuid
  productionId         String       @map("production_id") @db.Uuid
  name                 String
  snapshotType         SnapshotType @map("snapshot_type")
  totalCtd             Decimal?     @map("total_ctd") @db.Decimal(14, 2)
  totalCommitments     Decimal?     @map("total_commitments") @db.Decimal(14, 2)
  // The workbook's own bottom line. Parsed since the first version and never
  // stored, which left the dashboard showing remaining spend as the budget.
  grandTotal           Decimal?     @map("grand_total") @db.Decimal(14, 2)
  weeklyTotalsJson     Json         @map("weekly_totals_json")
  cumulativeTotalsJson Json         @map("cumulative_totals_json")
  createdBy            String?      @map("created_by")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  production           Production   @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@map("forecast_snapshots")
}

model HotCostDay {
  id            String            @id @default(uuid()) @db.Uuid
  productionId  String            @map("production_id") @db.Uuid
  importBatchId String?           @map("import_batch_id") @db.Uuid
  workDateLabel String?           @map("work_date_label")
  // Read from cell D2 of the day sheet, which states it outright.
  workDate      DateTime?         @map("work_date") @db.Date
  dayLabel      String?           @map("day_label")
  sheetName     String            @map("sheet_name")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  production    Production        @relation(fields: [productionId], references: [id], onDelete: Cascade)
  importBatch   ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  lineItems     HotCostLineItem[]

  @@index([productionId])
  @@index([importBatchId])
  @@map("hot_cost_days")
}

model HotCostLineItem {
  id              String     @id @default(uuid()) @db.Uuid
  productionId    String     @map("production_id") @db.Uuid
  hotCostDayId    String     @map("hot_cost_day_id") @db.Uuid
  accountCode     String?    @map("account_code")
  employeeName    String?    @map("employee_name")
  position        String?
  unionCode       String?    @map("union_code")
  rate            Decimal?   @db.Decimal(14, 2)
  // The day sheet states all three separately: TOTAL/DAY, BUDGET/DAY and
  // (OVER)/UNDER. The original import read the variance column and stored it as
  // the actual, understating labour by a factor of twenty-two.
  actualDayCost   Decimal?   @map("actual_day_cost") @db.Decimal(14, 2)
  budgetDayCost   Decimal?   @map("budget_day_cost") @db.Decimal(14, 2)
  dayVariance     Decimal?   @map("day_variance") @db.Decimal(14, 2)
  sourceRowNumber Int?       @map("source_row_number")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  production      Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  hotCostDay      HotCostDay @relation(fields: [hotCostDayId], references: [id], onDelete: Cascade)

  @@index([productionId])
  @@index([hotCostDayId])
  @@index([accountCode])
  @@map("hot_cost_line_items")
}
