generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImportSourceType {
  cashflow_xlsx
  hotcost_xls
}

enum ImportStatus {
  queued
  processing
  completed
  failed
  needs_review
}

enum PeriodType {
  ctd
  commitment
  preprep
  prep
  shoot
  hiatus
  post
}

enum CashFlowLineType {
  detail
  fringe
  subtotal
  header
  grand_total
  cumulative_total
}

enum SnapshotType {
  imported
  recalculated
  scenario
}

model Production {
  id            String             @id @default(uuid()) @db.Uuid
  title         String
  currency      String
  region        String?
  status        String
  startDate     DateTime?          @db.Date
  endDate       DateTime?          @db.Date
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  importBatches ImportBatch[]
  periods       CashFlowPeriod[]
  sections      CashFlowSection[]
  lineItems     CashFlowLineItem[]
  snapshots     ForecastSnapshot[]
  hotCostDays   HotCostDay[]
  hotCostLineItems HotCostLineItem[]

  @@map("productions")
}

model ImportBatch {
  id               String           @id @default(uuid()) @db.Uuid
  productionId     String           @map("production_id") @db.Uuid
  sourceType       ImportSourceType @map("source_type")
  originalFilename String           @map("original_filename")
  fileStorageKey   String           @map("file_storage_key")
  importStatus     ImportStatus     @map("import_status")
  parserVersion    String           @map("parser_version")
  startedAt        DateTime?        @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(6)
  errorSummary     String?          @map("error_summary")
  metadataJson     Json?            @map("metadata_json")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  production       Production       @relation(fields: [productionId], references: [id], onDelete: Cascade)
  lineItems        CashFlowLineItem[]
  hotCostDays      HotCostDay[]

  @@map("import_batches")
}

model CashFlowPeriod {
  id              String      @id @default(uuid()) @db.Uuid
  productionId    String      @map("production_id") @db.Uuid
  sequence        Int
  label           String
  periodType      PeriodType  @map("period_type")
  // Populated from the date row above the period labels. Present in the schema
  // from the start; never filled until the parser stopped keying off labels.
  weekEndingDate  DateTime?   @map("week_ending_date") @db.Date
  sourceColumnKey String      @map("source_column_key")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  production      Production  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  allocations     CashFlowAllocation[]

  @@unique([productionId, sequence])
  @@map("cash_flow_periods")
}

model CashFlowSection {
  id                   String             @id @default(uuid()) @db.Uuid
  productionId         String             @map("production_id") @db.Uuid
  code                 String?
  name                 String
  displayOrder         Int                @map("display_order")
  includedInGrandTotal Boolean            @default(true) @map("included_in_grand_total")
  sourceStartRow       Int?               @map("source_start_row")
  sourceEndRow         Int?               @map("source_end_row")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  production           Production         @relation(fields: [productionId], references: [id], onDelete: Cascade)
  lineItems            CashFlowLineItem[]

  @@unique([productionId, displayOrder])
  @@map("cash_flow_sections")
}

model CashFlowLineItem {
  id                String               @id @default(uuid()) @db.Uuid
  productionId      String               @map("production_id") @db.Uuid
  sectionId         String?              @map("section_id") @db.Uuid
  importBatchId     String?              @map("import_batch_id") @db.Uuid
  accountCode       String?              @map("account_code")
  description       String
  lineType          CashFlowLineType     @map("line_type")
  sourceRowNumber   Int?                 @map("source_row_number")
  ctdAmount         Decimal?             @map("ctd_amount") @db.Decimal(14, 2)
  commitmentsAmount Decimal?             @map("commitments_amount") @db.Decimal(14, 2)
  importedTotal     Decimal?             @map("imported_total") @db.Decimal(14, 2)
  formulaJson       Json?                @map("formula_json")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  production        Production           @relation(fields: [productionId], references: [id], onDelete: Cascade)
  section           CashFlowSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  importBatch       ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  allocations       CashFlowAllocation[]

  @@index([productionId])
  @@index([sectionId])
  @@index([accountCode])
  @@map("cash_flow_line_items")
}

model CashFlowAllocation {
  id               String            @id @default(uuid()) @db.Uuid
  lineItemId       String            @map("line_item_id") @db.Uuid
  periodId         String            @map("period_id") @db.Uuid
  amount           Decimal           @db.Decimal(14, 2)
  importedValue    Decimal?          @map("imported_value") @db.Decimal(14, 2)
  sourceFormula    String?           @map("source_formula")
  isManualOverride Boolean           @default(false) @map("is_manual_override")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  lineItem         CashFlowLineItem  @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  period           CashFlowPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([lineItemId, periodId])
  @@map("cash_flow_allocations")
}

model ForecastSnapshot {
  id                   String       @id @default(uuid()) @db.Uuid
  productionId         String       @map("production_id") @db.Uuid
  name                 String
  snapshotType         SnapshotType @map("snapshot_type")
  totalCtd             Decimal?     @map("total_ctd") @db.Decimal(14, 2)
  totalCommitments     Decimal?     @map("total_commitments") @db.Decimal(14, 2)
  // The workbook's own bottom line. Parsed since the first version and never
  // stored, which left the dashboard showing remaining spend as the budget.
  grandTotal           Decimal?     @map("grand_total") @db.Decimal(14, 2)
  weeklyTotalsJson     Json         @map("weekly_totals_json")
  cumulativeTotalsJson Json         @map("cumulative_totals_json")
  createdBy            String?      @map("created_by")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  production           Production   @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@map("forecast_snapshots")
}

model HotCostDay {
  id            String            @id @default(uuid()) @db.Uuid
  productionId  String            @map("production_id") @db.Uuid
  importBatchId String?           @map("import_batch_id") @db.Uuid
  workDateLabel String?           @map("work_date_label")
  // Read from cell D2 of the day sheet, which states it outright.
  workDate      DateTime?         @map("work_date") @db.Date
  dayLabel      String?           @map("day_label")
  sheetName     String            @map("sheet_name")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  production    Production        @relation(fields: [productionId], references: [id], onDelete: Cascade)
  importBatch   ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  lineItems     HotCostLineItem[]

  @@index([productionId])
  @@index([importBatchId])
  @@map("hot_cost_days")
}

model HotCostLineItem {
  id              String      @id @default(uuid()) @db.Uuid
  productionId    String      @map("production_id") @db.Uuid
  hotCostDayId    String      @map("hot_cost_day_id") @db.Uuid
  accountCode     String?     @map("account_code")
  employeeName    String?     @map("employee_name")
  position        String?
  unionCode       String?     @map("union_code")
  rate            Decimal?    @db.Decimal(14, 2)
  // The day sheet states all three separately: TOTAL/DAY, BUDGET/DAY and
  // (OVER)/UNDER. The original import read the variance column and stored it as
  // the actual, understating labour by a factor of twenty-two.
  actualDayCost   Decimal?    @map("actual_day_cost") @db.Decimal(14, 2)
  budgetDayCost   Decimal?    @map("budget_day_cost") @db.Decimal(14, 2)
  dayVariance     Decimal?    @map("day_variance") @db.Decimal(14, 2)
  sourceRowNumber Int?        @map("source_row_number")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  production      Production  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  hotCostDay      HotCostDay  @relation(fields: [hotCostDayId], references: [id], onDelete: Cascade)

  @@index([productionId])
  @@index([hotCostDayId])
  @@index([accountCode])
  @@map("hot_cost_line_items")
}
