DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cashflow"
PORT=3001

# Base URL used to build invite links. Falls back to the request's own host.
APP_URL="http://localhost:3001"
# Origin allowed to send the session cookie in development, where the SPA is
# served by Vite on a different port. Unset in production — the API serves it.
WEB_ORIGIN="http://localhost:5173"
# Address of the Python extractor service.
EXTRACTOR_URL="http://127.0.0.1:8000"
