DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cashflow"
PORT=3001

# Base URL used to build invite links. Falls back to the request's own host.
APP_URL="http://localhost:3001"
# Origin allowed to send the session cookie cross-origin. Only set this if the
# SPA is served from somewhere other than this API — a named origin, never a
# wildcard, because the session travels in a cookie. Defaults to the Vite dev
# server locally and to no cross-origin access at all on Railway.
WEB_ORIGIN="http://localhost:5173"

# Marks the session cookie Secure. Set automatically on Railway; set it here
# only if you terminate TLS yourself. NODE_ENV is deliberately not used for
# this — setting it to production makes npm skip the devDependencies the build
# needs (prisma, vite, vue-tsc).
# SECURE_COOKIES=true
# Address of the Python extractor service.
EXTRACTOR_URL="http://127.0.0.1:8000"
